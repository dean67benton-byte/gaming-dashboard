# Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Any long random string, used to sign the session cookie
SESSION_SECRET=
# Optional. Public URL of the app for the Steam sign in return address.
# Defaults to the URL the request came in on.
APP_URL=
# Set to 1 to show sample data without a Steam key
DEMO_MODE=
# Your Overwatch BattleTag, e.g. Name#1234. Career profile must be public.
OVERWATCH_BATTLETAG=
