# Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Any long random string, used to sign the session cookie
SESSION_SECRET=
# Optional. Public URL of the app for the Steam sign in return address.
# Defaults to the URL the request came in on.
APP_URL=
# Set to 1 to show sample data without a Steam key
DEMO_MODE=
# Your Overwatch BattleTag, e.g. Name#1234, or the career id from your
# overwatch.blizzard.com profile URL. Career profile must be public.
OVERWATCH_BATTLETAG=
# Optional: two-letter Steam store region for Deals prices (default US)
STEAM_COUNTRY=
# Optional: free Upstash Redis for recent session tracking (Vercel adds these when you connect it)
KV_REST_API_URL=
KV_REST_API_TOKEN=
